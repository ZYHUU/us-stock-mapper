# 复制为 .env 并填入真实值；.env 已在 .gitignore 中，不会被提交。

# 默认 WS 端点（未经股票名正则过滤的原始消息源）
WS_URL=wss://YOUR-WS-HOST/YOUR-PATH

# 旧端点（只推送已命中股票名/代码正则的消息）
WS_LEGACY_URL=wss://YOUR-WS-HOST/YOUR-LEGACY-PATH

# 未经股票名正则过滤的完整新闻网站源，{token} 占位符会被 WS_NEWS_TOKEN 自动替换
WS_NEWS_URL=wss://YOUR-NEWS-HOST/websocket?token={token}&topics=news
WS_NEWS_TOKEN=

# 如果连接需要鉴权
WS_AUTHORIZATION=
WS_COOKIE=
